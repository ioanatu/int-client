# --- Dev server proxy (values below never reach the browser bundle) -------------------
# Where the IntNext backend is running.
API_PROXY_TARGET=http://localhost:3000
# Shared secret the backend expects in the `X-SESSION` header of every /api/** request.
# Copy it from the server's own .env (or from the Render dashboard for a deployed API).
SESSION_TOKEN=local-dev-session-token

# --- Direct backend access (optional) -------------------------------------------------
# Only needed when the built bundle must call the API without the dev-server proxy.
# Anything prefixed VITE_ is inlined into the bundle and is therefore public.
# VITE_API_BASE_URL=https://int-server-ytx6.onrender.com/api/v1
# VITE_SESSION_TOKEN=
